# Use Fedora which has better BPF development support
FROM fedora:40

RUN dnf install -y \
    clang \
    llvm \
    libbpf-devel \
    kernel-devel \
    kernel-headers \
    make \
    git \
    bpftool \
    && dnf clean all

WORKDIR /src
COPY kernel/lsm/ .

# Use kernel-devel headers
RUN KDIR=$(find /usr/src/kernels -maxdepth 1 -type d -name '*' | head -1) make

CMD ["./loader"]